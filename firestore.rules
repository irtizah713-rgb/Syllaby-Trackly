rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function hasAcceptedFriendRequest(userId, friendUid) {
      return (
        exists(/databases/$(database)/documents/friendRequests/freq_$(userId)_$(friendUid)) &&
        get(/databases/$(database)/documents/friendRequests/freq_$(userId)_$(friendUid)).data.fromUid == userId &&
        get(/databases/$(database)/documents/friendRequests/freq_$(userId)_$(friendUid)).data.toUid == friendUid &&
        get(/databases/$(database)/documents/friendRequests/freq_$(userId)_$(friendUid)).data.status == 'ACCEPTED'
      ) || (
        exists(/databases/$(database)/documents/friendRequests/freq_$(friendUid)_$(userId)) &&
        get(/databases/$(database)/documents/friendRequests/freq_$(friendUid)_$(userId)).data.fromUid == friendUid &&
        get(/databases/$(database)/documents/friendRequests/freq_$(friendUid)_$(userId)).data.toUid == userId &&
        get(/databases/$(database)/documents/friendRequests/freq_$(friendUid)_$(userId)).data.status == 'ACCEPTED'
      );
    }

    function isValidTimestamp(ts) {
      return ts is timestamp && ts <= request.time;
    }

    function isValidStringList(arr, maxSize) {
      return arr is list && arr.size() <= maxSize && (arr.size() == 0 || arr[0] is string);
    }

    function isValidUserAccount(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.email is string && data.email.size() <= 160 &&
             data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 60 &&
             (!('photoUrl' in data) || (data.photoUrl is string && data.photoUrl.size() <= 500)) &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.level is int && data.level >= 1 && data.level <= 500 &&
             data.themePoints is int && data.themePoints >= 0 && data.themePoints <= 10000000 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.longestStreak is int && data.longestStreak >= 0 && data.longestStreak <= 10000 &&
             (!('lastActivityDate' in data) || (data.lastActivityDate is string && data.lastActivityDate.size() <= 20)) &&
             data.totalFocusMinutes is int && data.totalFocusMinutes >= 0 && data.totalFocusMinutes <= 10000000 &&
             data.dailyGoalMinutes is int && data.dailyGoalMinutes >= 5 && data.dailyGoalMinutes <= 720 &&
             (!('academicSession' in data) || (data.academicSession is string && data.academicSession.size() <= 60)) &&
             (!('academicClass' in data) || (data.academicClass is string && data.academicClass.size() <= 60)) &&
             (!('academicStream' in data) || (data.academicStream is string && data.academicStream.size() <= 60)) &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             data.selectedFrameId is string && data.selectedFrameId.size() >= 1 && data.selectedFrameId.size() <= 64 &&
             isValidStringList(data.unlockedShopIds, 100) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidPublicProfile(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.username is string && data.username.size() >= 1 && data.username.size() <= 60 &&
             data.friendCode is string && data.friendCode.size() >= 4 && data.friendCode.size() <= 20 &&
             (!('bio' in data) || (data.bio is string && data.bio.size() <= 240)) &&
             (!('academicClass' in data) || (data.academicClass is string && data.academicClass.size() <= 60)) &&
             (!('academicStream' in data) || (data.academicStream is string && data.academicStream.size() <= 60)) &&
             data.level is int && data.level >= 1 && data.level <= 500 &&
             data.xp is int && data.xp >= 0 && data.xp <= 10000000 &&
             data.rankTitle is string && data.rankTitle.size() >= 1 && data.rankTitle.size() <= 40 &&
             data.currentStreak is int && data.currentStreak >= 0 && data.currentStreak <= 10000 &&
             data.totalFocusMinutes is int && data.totalFocusMinutes >= 0 && data.totalFocusMinutes <= 10000000 &&
             data.selectedFrameId is string && data.selectedFrameId.size() >= 1 && data.selectedFrameId.size() <= 64 &&
             data.discoverable is bool &&
             data.showStats is bool &&
             data.showAchievements is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidSubject(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.name is string && data.name.size() >= 1 && data.name.size() <= 80 &&
             data.colorHex is string && data.colorHex.size() >= 4 && data.colorHex.size() <= 12 &&
             data.iconKey is string && data.iconKey.size() >= 1 && data.iconKey.size() <= 40 &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             (!('examDateMillis' in data) || (data.examDateMillis is int && data.examDateMillis >= 0)) &&
             data.targetChapters is int && data.targetChapters >= 0 && data.targetChapters <= 500 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidChapter(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 120 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             (!('personalNotes' in data) || (data.personalNotes is string && data.personalNotes.size() <= 4000)) &&
             (!('topicsCsv' in data) || (data.topicsCsv is string && data.topicsCsv.size() <= 1000)) &&
             data.status in ['INCOMPLETE', 'COMPLETED', 'REVISED', 'PRACTISED', 'NUMERICALS_PRACTISED'] &&
             data.sortOrder is int && data.sortOrder >= 0 && data.sortOrder <= 10000 &&
             (!('completedAtMillis' in data) || (data.completedAtMillis is int && data.completedAtMillis >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTask(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 140 &&
             (!('description' in data) || (data.description is string && data.description.size() <= 1000)) &&
             data.priority in ['LOW', 'MEDIUM', 'HIGH', 'URGENT'] &&
             data.category is string && data.category.size() >= 1 && data.category.size() <= 40 &&
             isValidStringList(data.tags, 10) &&
             (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128)) &&
             (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() <= 128)) &&
             (!('dueAtMillis' in data) || (data.dueAtMillis is int && data.dueAtMillis >= 0)) &&
             data.reminderEnabled is bool &&
             data.completed is bool &&
             (!('completedAtMillis' in data) || (data.completedAtMillis is int && data.completedAtMillis >= 0)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidNote(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 160 &&
             data.content is string && data.content.size() <= 20000 &&
             (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128)) &&
             (!('chapterId' in data) || (data.chapterId is string && data.chapterId.size() <= 128)) &&
             data.pinned is bool &&
             data.favorite is bool &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFocusSession(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             (!('subjectId' in data) || (data.subjectId is string && data.subjectId.size() <= 128)) &&
             (!('subjectName' in data) || (data.subjectName is string && data.subjectName.size() <= 80)) &&
             data.durationMinutes is int && data.durationMinutes >= 1 && data.durationMinutes <= 600 &&
             data.breakMinutes is int && data.breakMinutes >= 0 && data.breakMinutes <= 120 &&
             data.modeLabel is string && data.modeLabel.size() >= 1 && data.modeLabel.size() <= 40 &&
             data.ambientSound is string && data.ambientSound.size() >= 1 && data.ambientSound.size() <= 40 &&
             data.completed is bool &&
             data.startedAtMillis is int && data.startedAtMillis >= 0 &&
             data.endedAtMillis is int && data.endedAtMillis >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidAttendance(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.dateKey is string && data.dateKey.size() >= 8 && data.dateKey.size() <= 12 &&
             data.subjectId is string && data.subjectId.size() >= 1 && data.subjectId.size() <= 128 &&
             data.status in ['PRESENT', 'ABSENT', 'HOLIDAY'] &&
             (!('note' in data) || (data.note is string && data.note.size() <= 200)) &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidTransaction(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.currency in ['XP', 'THEME_POINTS'] &&
             data.amount is int && data.amount >= -100000 && data.amount <= 100000 &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 120 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidAchievement(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.achievementKey is string && data.achievementKey.size() >= 1 && data.achievementKey.size() <= 64 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.unlockedAtMillis is int && data.unlockedAtMillis >= 0 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidFriendLink(data) {
      return data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128 &&
             data.friendUid is string && data.friendUid.size() >= 1 && data.friendUid.size() <= 128 &&
             data.friendUsername is string && data.friendUsername.size() >= 1 && data.friendUsername.size() <= 60 &&
             data.friendCode is string && data.friendCode.size() >= 1 && data.friendCode.size() <= 20 &&
             data.relationStatus in ['FRIEND', 'BLOCKED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidFriendRequest(data) {
      return data.fromUid is string && data.fromUid.size() >= 1 && data.fromUid.size() <= 128 &&
             data.fromUsername is string && data.fromUsername.size() >= 1 && data.fromUsername.size() <= 60 &&
             data.fromFriendCode is string && data.fromFriendCode.size() >= 1 && data.fromFriendCode.size() <= 20 &&
             data.toUid is string && data.toUid.size() >= 1 && data.toUid.size() <= 128 &&
             data.toUsername is string && data.toUsername.size() >= 1 && data.toUsername.size() <= 60 &&
             data.status in ['PENDING', 'ACCEPTED', 'DECLINED'] &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidStudyRoom(data) {
      return data.hostUid is string && data.hostUid.size() >= 1 && data.hostUid.size() <= 128 &&
             data.hostName is string && data.hostName.size() >= 1 && data.hostName.size() <= 60 &&
             data.title is string && data.title.size() >= 1 && data.title.size() <= 80 &&
             data.description is string && data.description.size() <= 240 &&
             data.environment in ['FOREST', 'LIBRARY', 'CLASSROOM'] &&
             data.privacy in ['PUBLIC', 'PRIVATE'] &&
             data.inviteCode is string && data.inviteCode.size() >= 4 && data.inviteCode.size() <= 20 &&
             isValidStringList(data.invitedUids, 50) &&
             isValidStringList(data.memberUids, 100) &&
             data.timerState in ['IDLE', 'RUNNING', 'PAUSED', 'BREAK'] &&
             data.timerDurationMinutes is int && data.timerDurationMinutes >= 1 && data.timerDurationMinutes <= 180 &&
             data.timerRemainingSeconds is int && data.timerRemainingSeconds >= 0 && data.timerRemainingSeconds <= 10800 &&
             data.timerUpdatedAtMillis is int && data.timerUpdatedAtMillis >= 0 &&
             isValidTimestamp(data.createdAt) &&
             isValidTimestamp(data.updatedAt);
    }

    function isValidRoomMessage(data) {
      return data.roomId is string && data.roomId.size() >= 1 && data.roomId.size() <= 128 &&
             data.senderUid is string && data.senderUid.size() >= 1 && data.senderUid.size() <= 128 &&
             data.senderName is string && data.senderName.size() >= 1 && data.senderName.size() <= 60 &&
             data.text is string && data.text.size() >= 1 && data.text.size() <= 500 &&
             data.expiresAtMillis is int && data.expiresAtMillis > 0 &&
             isValidTimestamp(data.createdAt);
    }

    function isValidReport(data) {
      return data.reporterUid is string && data.reporterUid.size() >= 1 && data.reporterUid.size() <= 128 &&
             data.targetType in ['USER', 'ROOM', 'MESSAGE'] &&
             data.targetId is string && data.targetId.size() >= 1 && data.targetId.size() <= 128 &&
             data.reason is string && data.reason.size() >= 1 && data.reason.size() <= 80 &&
             data.details is string && data.details.size() <= 500 &&
             isValidTimestamp(data.createdAt);
    }

    match /users/{userId} {
      allow get, list: if isOwner(userId);
      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'email', 'displayName', 'xp', 'level', 'themePoints', 'currentStreak', 'longestStreak', 'totalFocusMinutes', 'dailyGoalMinutes', 'selectedFrameId', 'unlockedShopIds', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'email', 'displayName', 'photoUrl', 'xp', 'level', 'themePoints', 'currentStreak', 'longestStreak', 'lastActivityDate', 'totalFocusMinutes', 'dailyGoalMinutes', 'academicSession', 'academicClass', 'academicStream', 'bio', 'selectedFrameId', 'unlockedShopIds', 'createdAt', 'updatedAt']) &&
                       isValidUserAccount(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidUserAccount(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoUrl', 'xp', 'level', 'themePoints', 'currentStreak', 'longestStreak', 'lastActivityDate', 'totalFocusMinutes', 'dailyGoalMinutes', 'academicSession', 'academicClass', 'academicStream', 'bio', 'selectedFrameId', 'unlockedShopIds', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);

      match /subjects/{subjectId} {
        allow get: if isOwner(userId) && isValidId(subjectId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(subjectId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'name', 'colorHex', 'iconKey', 'sortOrder', 'targetChapters', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'name', 'colorHex', 'iconKey', 'sortOrder', 'examDateMillis', 'targetChapters', 'createdAt', 'updatedAt']) &&
                         isValidSubject(incoming());
        allow update: if isOwner(userId) && isValidId(subjectId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidSubject(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'colorHex', 'iconKey', 'sortOrder', 'examDateMillis', 'targetChapters', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(subjectId);
      }

      match /chapters/{chapterId} {
        allow get: if isOwner(userId) && isValidId(chapterId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(chapterId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'subjectId', 'title', 'status', 'sortOrder', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'title', 'description', 'personalNotes', 'topicsCsv', 'status', 'sortOrder', 'completedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidChapter(incoming());
        allow update: if isOwner(userId) && isValidId(chapterId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidChapter(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['subjectId', 'title', 'description', 'personalNotes', 'topicsCsv', 'status', 'sortOrder', 'completedAtMillis', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(chapterId);
      }

      match /tasks/{taskId} {
        allow get: if isOwner(userId) && isValidId(taskId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(taskId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'priority', 'category', 'tags', 'reminderEnabled', 'completed', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'description', 'priority', 'category', 'tags', 'subjectId', 'chapterId', 'dueAtMillis', 'reminderEnabled', 'completed', 'completedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidTask(incoming());
        allow update: if isOwner(userId) && isValidId(taskId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidTask(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'priority', 'category', 'tags', 'subjectId', 'chapterId', 'dueAtMillis', 'reminderEnabled', 'completed', 'completedAtMillis', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(taskId);
      }

      match /notes/{noteId} {
        allow get: if isOwner(userId) && isValidId(noteId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(noteId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'title', 'content', 'pinned', 'favorite', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'title', 'content', 'subjectId', 'chapterId', 'pinned', 'favorite', 'createdAt', 'updatedAt']) &&
                         isValidNote(incoming());
        allow update: if isOwner(userId) && isValidId(noteId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidNote(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'content', 'subjectId', 'chapterId', 'pinned', 'favorite', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(noteId);
      }

      match /focusSessions/{sessionId} {
        allow get: if isOwner(userId) && isValidId(sessionId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(sessionId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'durationMinutes', 'breakMinutes', 'modeLabel', 'ambientSound', 'completed', 'startedAtMillis', 'endedAtMillis', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'subjectId', 'subjectName', 'durationMinutes', 'breakMinutes', 'modeLabel', 'ambientSound', 'completed', 'startedAtMillis', 'endedAtMillis', 'createdAt', 'updatedAt']) &&
                         isValidFocusSession(incoming());
        allow update: if false;
        allow delete: if isOwner(userId) && isValidId(sessionId);
      }

      match /attendance/{recordId} {
        allow get: if isOwner(userId) && isValidId(recordId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(recordId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'dateKey', 'subjectId', 'status', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'dateKey', 'subjectId', 'status', 'note', 'createdAt', 'updatedAt']) &&
                         isValidAttendance(incoming());
        allow update: if isOwner(userId) && isValidId(recordId) &&
                         incoming().userId == existing().userId &&
                         incoming().createdAt == existing().createdAt &&
                         isValidAttendance(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['status', 'note', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(recordId);
      }

      match /transactions/{txId} {
        allow get: if isOwner(userId) && isValidId(txId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(txId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'currency', 'amount', 'reason', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'currency', 'amount', 'reason', 'createdAt']) &&
                         isValidTransaction(incoming());
        allow update, delete: if false;
      }

      match /achievements/{achievementId} {
        allow get: if isOwner(userId) && isValidId(achievementId);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(achievementId) &&
                         incoming().userId == userId &&
                         incoming().keys().hasAll(['userId', 'achievementKey', 'title', 'unlockedAtMillis', 'createdAt']) &&
                         incoming().keys().hasOnly(['userId', 'achievementKey', 'title', 'unlockedAtMillis', 'createdAt']) &&
                         isValidAchievement(incoming());
        allow update, delete: if false;
      }

      match /friends/{friendUid} {
        allow get: if isOwner(userId) && isValidId(friendUid);
        allow list: if isOwner(userId);
        allow create: if isOwner(userId) && isValidId(friendUid) &&
                         incoming().userId == userId &&
                         incoming().friendUid == friendUid &&
                         incoming().relationStatus == 'FRIEND' &&
                         hasAcceptedFriendRequest(userId, friendUid) &&
                         incoming().keys().hasAll(['userId', 'friendUid', 'friendUsername', 'friendCode', 'relationStatus', 'createdAt', 'updatedAt']) &&
                         incoming().keys().hasOnly(['userId', 'friendUid', 'friendUsername', 'friendCode', 'relationStatus', 'createdAt', 'updatedAt']) &&
                         isValidFriendLink(incoming());
        allow update: if isOwner(userId) && isValidId(friendUid) &&
                         incoming().userId == existing().userId &&
                         incoming().friendUid == existing().friendUid &&
                         incoming().createdAt == existing().createdAt &&
                         isValidFriendLink(incoming()) &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['friendUsername', 'relationStatus', 'updatedAt']);
        allow delete: if isOwner(userId) && isValidId(friendUid);
      }
    }

    match /publicProfiles/{userId} {
      allow get: if isSignedIn() && isValidId(userId) && (isOwner(userId) || existing().discoverable == true);
      allow list: if isSignedIn() && (resource.data.discoverable == true || resource.data.userId == request.auth.uid);
      allow create: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == userId &&
                       incoming().keys().hasAll(['userId', 'username', 'friendCode', 'level', 'xp', 'rankTitle', 'currentStreak', 'totalFocusMinutes', 'selectedFrameId', 'discoverable', 'showStats', 'showAchievements', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['userId', 'username', 'friendCode', 'bio', 'academicClass', 'academicStream', 'level', 'xp', 'rankTitle', 'currentStreak', 'totalFocusMinutes', 'selectedFrameId', 'discoverable', 'showStats', 'showAchievements', 'createdAt', 'updatedAt']) &&
                       isValidPublicProfile(incoming());
      allow update: if isOwner(userId) && isValidId(userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       isValidPublicProfile(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['username', 'bio', 'academicClass', 'academicStream', 'level', 'xp', 'rankTitle', 'currentStreak', 'totalFocusMinutes', 'selectedFrameId', 'discoverable', 'showStats', 'showAchievements', 'updatedAt']);
      allow delete: if isOwner(userId) && isValidId(userId);
    }

    match /friendRequests/{requestId} {
      allow get: if isSignedIn() && isValidId(requestId) &&
                    (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
      allow list: if isSignedIn() &&
                     (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      allow create: if isSignedIn() && isValidId(requestId) &&
                       incoming().fromUid == request.auth.uid &&
                       incoming().toUid != request.auth.uid &&
                       incoming().status == 'PENDING' &&
                       incoming().keys().hasAll(['fromUid', 'fromUsername', 'fromFriendCode', 'toUid', 'toUsername', 'status', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['fromUid', 'fromUsername', 'fromFriendCode', 'toUid', 'toUsername', 'status', 'createdAt', 'updatedAt']) &&
                       isValidFriendRequest(incoming());
      allow update: if isSignedIn() && isValidId(requestId) &&
                       existing().status == 'PENDING' &&
                       incoming().fromUid == existing().fromUid &&
                       incoming().toUid == existing().toUid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidFriendRequest(incoming()) &&
                       incoming().diff(existing()).affectedKeys().hasOnly(['status', 'updatedAt']) &&
                       ((request.auth.uid == existing().toUid && incoming().status in ['ACCEPTED', 'DECLINED']) ||
                        (request.auth.uid == existing().fromUid && incoming().status == 'DECLINED'));
      allow delete: if isSignedIn() && isValidId(requestId) &&
                       (existing().fromUid == request.auth.uid || existing().toUid == request.auth.uid);
    }

    match /studyRooms/{roomId} {
      allow get: if isSignedIn() && isValidId(roomId) &&
                    (existing().privacy == 'PUBLIC' ||
                     existing().hostUid == request.auth.uid ||
                     request.auth.uid in existing().memberUids ||
                     request.auth.uid in existing().invitedUids);
      allow list: if isSignedIn() &&
                     (resource.data.privacy == 'PUBLIC' ||
                      resource.data.hostUid == request.auth.uid ||
                      request.auth.uid in resource.data.memberUids ||
                      request.auth.uid in resource.data.invitedUids);
      allow create: if isSignedIn() && isValidId(roomId) &&
                       incoming().hostUid == request.auth.uid &&
                       incoming().memberUids.size() == 1 &&
                       incoming().memberUids[0] == request.auth.uid &&
                       !(request.auth.uid in incoming().invitedUids) &&
                       incoming().keys().hasAll(['hostUid', 'hostName', 'title', 'description', 'environment', 'privacy', 'inviteCode', 'invitedUids', 'memberUids', 'timerState', 'timerDurationMinutes', 'timerRemainingSeconds', 'timerUpdatedAtMillis', 'createdAt', 'updatedAt']) &&
                       incoming().keys().hasOnly(['hostUid', 'hostName', 'title', 'description', 'environment', 'privacy', 'inviteCode', 'invitedUids', 'memberUids', 'timerState', 'timerDurationMinutes', 'timerRemainingSeconds', 'timerUpdatedAtMillis', 'createdAt', 'updatedAt']) &&
                       isValidStudyRoom(incoming());
      allow update: if isSignedIn() && isValidId(roomId) &&
                       incoming().hostUid == existing().hostUid &&
                       incoming().createdAt == existing().createdAt &&
                       isValidStudyRoom(incoming()) && (
                         (request.auth.uid == existing().hostUid &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['title', 'description', 'environment', 'privacy', 'invitedUids', 'memberUids', 'timerState', 'timerDurationMinutes', 'timerRemainingSeconds', 'timerUpdatedAtMillis', 'updatedAt'])) ||
                         ((existing().privacy == 'PUBLIC' || request.auth.uid in existing().invitedUids || request.auth.uid in existing().memberUids) &&
                          incoming().diff(existing()).affectedKeys().hasOnly(['memberUids', 'updatedAt']) &&
                          (
                            (incoming().memberUids.size() == existing().memberUids.size() + 1 &&
                             incoming().memberUids.hasAll(existing().memberUids) &&
                             request.auth.uid in incoming().memberUids &&
                             !(request.auth.uid in existing().memberUids)) ||
                            (existing().memberUids.size() == incoming().memberUids.size() + 1 &&
                             existing().memberUids.hasAll(incoming().memberUids) &&
                             request.auth.uid in existing().memberUids &&
                             !(request.auth.uid in incoming().memberUids))
                          ))
                       );
      allow delete: if isSignedIn() && isValidId(roomId) && existing().hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow get, list: if isSignedIn() && isValidId(roomId) &&
                      exists(/databases/$(database)/documents/studyRooms/$(roomId)) &&
                      (
                        get(/databases/$(database)/documents/studyRooms/$(roomId)).data.privacy == 'PUBLIC' ||
                        get(/databases/$(database)/documents/studyRooms/$(roomId)).data.hostUid == request.auth.uid ||
                        request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids ||
                        request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.invitedUids
                      );
        allow create: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
                         incoming().roomId == roomId &&
                         incoming().senderUid == request.auth.uid &&
                         incoming().keys().hasAll(['roomId', 'roomHostUid', 'roomPrivacy', 'roomAllowedUids', 'senderUid', 'senderName', 'text', 'expiresAtMillis', 'createdAt']) &&
                         incoming().keys().hasOnly(['roomId', 'roomHostUid', 'roomPrivacy', 'roomAllowedUids', 'senderUid', 'senderName', 'text', 'expiresAtMillis', 'createdAt']) &&
                         isValidRoomMessage(incoming()) &&
                         exists(/databases/$(database)/documents/studyRooms/$(roomId)) &&
                         (
                           get(/databases/$(database)/documents/studyRooms/$(roomId)).data.privacy == 'PUBLIC' ||
                           request.auth.uid == get(/databases/$(database)/documents/studyRooms/$(roomId)).data.hostUid ||
                           request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.memberUids ||
                           request.auth.uid in get(/databases/$(database)/documents/studyRooms/$(roomId)).data.invitedUids
                         ) &&
                         incoming().roomId == roomId;
        allow update: if false;
        allow delete: if isSignedIn() && isValidId(roomId) && isValidId(messageId) &&
                         (existing().senderUid == request.auth.uid ||
                          (exists(/databases/$(database)/documents/studyRooms/$(roomId)) &&
                           get(/databases/$(database)/documents/studyRooms/$(roomId)).data.hostUid == request.auth.uid));
      }
    }

    match /reports/{reportId} {
      allow get: if isSignedIn() && isValidId(reportId) && existing().reporterUid == request.auth.uid;
      allow list: if isSignedIn() && resource.data.reporterUid == request.auth.uid;
      allow create: if isSignedIn() && isValidId(reportId) &&
                       incoming().reporterUid == request.auth.uid &&
                       incoming().keys().hasAll(['reporterUid', 'targetType', 'targetId', 'reason', 'details', 'createdAt']) &&
                       incoming().keys().hasOnly(['reporterUid', 'targetType', 'targetId', 'reason', 'details', 'createdAt']) &&
                       isValidReport(incoming());
      allow update, delete: if false;
    }
  }
}
