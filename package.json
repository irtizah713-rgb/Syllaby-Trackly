{
  "name": "syllaby-trackly-security-tests",
  "private": true,
  "version": "1.0.0",
  "description": "Firestore security rules test harness for Syllaby-Trackly",
  "scripts": {
    "test": "npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project demo-no-project \"node --test firestore.test.js\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.10.0",
    "firebase-tools": "^14.22.0"
  }
}
